# --- Pflicht ---
PAYLOAD_SECRET=bitte-durch-langen-zufallswert-ersetzen
# SQLite-Datei (im Docker-Image: /data/db/reparierbar.db)
DATABASE_URI=file:./data/reparierbar.db
# Öffentliche Basis-URL: persönliche Links in Mails, CORS/CSRF
PUBLIC_URL=http://localhost:3000

# --- Optional ---
# Name vor der ersten Konfiguration (danach gelten die Einstellungen im Admin-Panel)
INSTANZ_NAME=Repair Café
# Schema-Push statt Migrationen – nur lokal in der Entwicklung
DB_PUSH=false
# Weitere erlaubte Origins (z. B. Web-Frontend), kommagetrennt
CORS_ORIGINS=

# Mail (SMTP); ohne SMTP_HOST werden Mails nicht verschickt
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=repaircafe@example.org
MAIL_FROM_NAME=

# Bilder (im Docker-Image: /data/bilder)
BILDER_DIR=./data/bilder
TZ=Europe/Berlin
