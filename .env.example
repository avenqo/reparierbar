# Payload
PAYLOAD_SECRET=bitte-durch-langen-zufallswert-ersetzen
DATABASE_URI=postgres://reparierbar:reparierbar@localhost:5432/reparierbar
# true nur für die lokale Entwicklung (Schema-Push statt Migrationen)
DB_PUSH=false

# Öffentliche Basis-URL (persönliche Links in Mails, CORS/CSRF)
PUBLIC_URL=https://repaircafe.kremmener.info
# Weitere erlaubte Origins, kommagetrennt (z. B. Entwicklungs-Frontends)
CORS_ORIGINS=

# Mail (SMTP der eigenen Domain); ohne SMTP_HOST werden Mails nur ins Log geschrieben
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=repaircafe@kremmener.info
MAIL_FROM_NAME=Repair Café Kremmen

# Bilder
BILDER_DIR=/data/bilder

# Zeitzone (Cron-Jobs, Erinnerungen)
TZ=Europe/Berlin

# Datenbank-Passwort für docker-compose
DB_PASSWORD=bitte-aendern
